package {
    // See: http://go/android-license-faq
    default_applicable_licenses: ["external_mesa3d_license"],
}

cc_library_static {
    name: "goldfish_address_space",
    vendor: true,
    c_std: "c11",
    cpp_std: "c++17",
    host_supported: true,
    defaults: [
        "_trial_c",
        "_trial_msvc",
        "_trial_soong_c",
        "_trial_soong_cpp",
        "aosp_mesa3d_c_link_args",
        "aosp_mesa3d_c_project_args",
        "aosp_mesa3d_cpp_link_args",
        "aosp_mesa3d_cpp_project_args",
        "gfxstream_guest_args",
        "vulkan_wsi_list",
    ],
    header_libs: [
        "inc_aemu",
        "inc_goldfish_address_space",
        "inc_guest_iostream",
        "inc_include",
        "inc_platform_virtgpu",
        "inc_src",
    ],
    srcs: [
        "AddressSpaceStream.cpp",
        "VirtioGpuAddressSpaceStream.cpp",
    ] + select(os(), {
        "android": [
            "GoldfishAddressSpaceStream.cpp",
            "goldfish_address_space.cpp",
        ],
        default: [],
    }),
    static_libs: [
        "blake3",
        "gfxstream_vulkan_mapper",
        "libvirtgpu_kumquat_ffi",
        "mesa_util",
        "mesa_util_c11",
        "mesa_util_simd",
        "platform_virtgpu",
        "platform_virtgpu_drm",
        "platform_virtgpu_kumquat",
        "vulkan_util",
    ] + select((os(), soong_config_variable("aosp_mesa3d", "perfetto")), {
        ("android", "true"): [
            "libperfetto_client_experimental",
        ],
        (default, default): [],
    }) + select(arch(), {
        "x86_64": [
            "mesa_util_clflush",
            "mesa_util_clflushopt",
        ],
        "x86": [
            "mesa_util_clflush",
            "mesa_util_clflushopt",
        ],
        default: [],
    }),
    shared_libs: [
        "libdrm",
    ],
}
