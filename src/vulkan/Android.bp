package {
    // See: http://go/android-license-faq
    default_applicable_licenses: ["external_mesa3d_license"],
}

cc_defaults {
    name: "vulkan_wsi_list",
    vendor: true,
    host_supported: true,
    cflags: select(os(), {
        "android": [
            "-DVK_USE_PLATFORM_ANDROID_KHR",
        ],
        default: [],
    }) + select((arch(), os()), {
        ("x86_64", "linux_glibc"): [
            "-DVK_USE_PLATFORM_DISPLAY_KHR",
        ],
        ("x86_64", "linux_musl"): [
            "-DVK_USE_PLATFORM_DISPLAY_KHR",
        ],
        ("arm64", "linux_musl"): [
            "-DVK_USE_PLATFORM_DISPLAY_KHR",
        ],
        (default, default): [],
    }),
    cppflags: select(os(), {
        "android": [
            "-DVK_USE_PLATFORM_ANDROID_KHR",
        ],
        default: [],
    }),
}
