package {
    // See: http://go/android-license-faq
    default_applicable_licenses: ["external_mesa3d_license"],
}

rust_library {
    name: "libmagma_gpu",
    vendor: true,
    edition: "2021",
    crate_root: "lib.rs",
    crate_name: "magma_gpu",
    host_supported: true,
    defaults: [
        "rust_global_args",
    ],
    rustlibs: [
        "libcfg_if",
        "liblog_rust",
        "librustix",
        "libthiserror",
        "libzerocopy",
    ],
    proc_macros: [
        "libremain",
    ],
}
